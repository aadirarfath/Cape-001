# Copy to apps/web/.env.local. Only the anon key belongs here — never service_role.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Cloudflare Turnstile site key for OTP captcha protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: Google Search Console HTML tag verification value (the content= attribute value only).
NEXT_PUBLIC_GSC_SITE_VERIFICATION=
