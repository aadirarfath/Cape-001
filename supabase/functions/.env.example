# Copy to supabase/functions/.env for local development (loaded on `pnpm db:start`).
# Hosted project: set these with `supabase secrets set NAME=value` instead.

# Shared secret for the notify-booking function. Locally it must match the value
# supabase/seed.sql stores in Vault as notify_booking_secret.
NOTIFY_BOOKING_SECRET=local-dev-notify-booking-secret

# Optional: only needed after turning on "enhanced push security" for the Expo project.
# EXPO_ACCESS_TOKEN=

# Razorpay — use test-mode keys locally (rzp_test_*).
# Get from https://dashboard.razorpay.com → Settings → API Keys.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
# Webhook secret — set in Razorpay dashboard → Webhooks (use a random string locally).
RAZORPAY_WEBHOOK_SECRET=local-dev-razorpay-webhook-secret
