# Cape 001 environment variables
# Copy this file to the location noted for each variable and fill in real values.
# Never commit real .env files.
#
# Local development: run `pnpm db:start` and copy the values it prints.
# Hosted project: Supabase dashboard -> Project Settings -> API.

# --- apps/web/.env.local -----------------------------------------------------
# The Supabase project URL and the anon (public) key. Safe for the browser:
# access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- apps/partner/.env --------------------------------------------------------
# Same project, exposed to the Expo app via the EXPO_PUBLIC_ prefix.
# On a physical phone, replace 127.0.0.1 with your computer's LAN IP.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Root .env (CLI / CI only — never loaded by apps/web or apps/partner) -----
# Used by the Supabase CLI to link and push migrations to the hosted project.
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-database-password

# The service_role key bypasses RLS. It must NEVER appear in apps/web or
# apps/partner. Only server-side tooling outside those apps (e.g. Edge Functions,
# where Supabase injects it automatically) may use it.
